# ============================================
# 素材目录（保留目录结构，忽略大型二进制）
# ============================================
# 视频文件
materials/**/*.mp4
materials/**/*.mov
materials/**/*.avi
materials/**/*.mkv
materials/**/*.flv
materials/**/*.wmv
materials/**/*.webm
materials/**/*.m4v
