{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/demo-pre-commit-guard.ps1\"'",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/requirement-change-detector.ps1\"'",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/session-restore.ps1\"'",
            "timeout": 25
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/demo-subagent-context.ps1\"'",
            "timeout": 15
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/pre-compact-save.ps1\"'",
            "timeout": 25
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/demo-post-code-check.ps1\"'",
            "timeout": 150
          },
          {
            "type": "command",
            "command": "bash -c 'powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$CODEBUDDY_PROJECT_DIR/.codex/hooks/demo-handover-reminder.ps1\"'",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
