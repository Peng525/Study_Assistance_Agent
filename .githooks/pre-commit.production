#!/bin/sh

repo_root="$(git rev-parse --show-toplevel)" || exit 1
validator="$repo_root/.codex/hooks/validate-qa-gates.ps1"

if [ ! -f "$validator" ]; then
  echo "Commit blocked: QA validator is missing: $validator" >&2
  exit 1
fi

powershell.exe -NoProfile -ExecutionPolicy Bypass -File "$validator" -ProjectRoot "$repo_root"
exit $?
